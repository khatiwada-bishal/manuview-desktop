{
  "name": "manuview-desktop",
  "version": "0.3.97",
  "private": true,
  "type": "module",
  "description": "ManuView Desktop - AI Pre-Submission Peer Review & Research Suite",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:mac": "./scripts/build-mac.sh",
    "test": "tsx --test test/**/*.test.ts",
    "benchmark": "tsx benchmarks/runners/run-all.ts",
    "benchmark:gold": "tsx benchmarks/runners/run-all.ts --layer=A",
    "benchmark:corpus": "tsx benchmarks/runners/run-all.ts --layer=B",
    "benchmark:llm": "tsx benchmarks/llm-eval/run-llm-eval.ts",
    "audit:npm": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.44.0",
    "mammoth": "^1.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
